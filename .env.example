# Ключ Claude API. Без него сервис работает в резервном режиме (ответы по базе без ИИ).
ANTHROPIC_API_KEY=

# Модель и глубина рассуждений. low — минимальная задержка для чата.
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low
# Время жизни кэша базы знаний на стороне API: 1h или 5m.
PROMPT_CACHE_TTL=1h

# amoCRM (необязательно). Без них — демо-сделки.
AMO_SUBDOMAIN=
AMO_TOKEN=
AMO_WEBHOOK_SECRET=
